# Postgres for the admin panel (Payload CMS), e.g. postgresql://user:password@localhost:5432/pcwizard
DATABASE_URL=
# Long random string that signs admin sessions: openssl rand -hex 32
PAYLOAD_SECRET=
# Folder for uploaded product photos (default: ./media next to the app); keep it on a persistent volume
MEDIA_DIR=
# Public address of the site, used in metadata and the sitemap
NEXT_PUBLIC_SITE_URL=https://pcwizard.uz
